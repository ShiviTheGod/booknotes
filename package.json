{
  "name": "booknotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal reading-notes app. Capture key ideas chapter by chapter, then keep them on a shelf.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && cross-env BUILD_TARGET=native vite build",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "booknotes-native": "file:packages/booknotes-native",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
