{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Tests read the source tree from disk to check the schema, so unlike the app
    // itself they legitimately need Node's APIs.
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/test/**/*.ts"]
}
